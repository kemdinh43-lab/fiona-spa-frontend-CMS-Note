{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts",
    "src/data/mockData.ts",
    "src/shared/seo/metadata.ts",
    "src/shared/types/spa.ts"
  ]
}
